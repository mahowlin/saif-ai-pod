# Red Hat Operators catalog mirrored to local registry
# Contains: nfd (Node Feature Discovery), local-storage-operator
apiVersion: operators.coreos.com/v1alpha1
kind: CatalogSource
metadata:
  name: redhat-operators-local
  namespace: openshift-marketplace
spec:
  sourceType: grpc
  image: {{ infrastructure.registry.hostname }}:{{ infrastructure.registry.port }}/redhat/redhat-operator-index:v{{ cluster.openshift_version }}
  displayName: Red Hat Operators (Mirrored)
  publisher: Red Hat (local mirror)
  updateStrategy:
    registryPoll:
      interval: 30m
