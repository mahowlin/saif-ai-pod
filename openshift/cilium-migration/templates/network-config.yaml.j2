#------------------------------------------------------------------------------
# OpenShift Network Configuration for Cilium with Kube-Proxy Replacement
#------------------------------------------------------------------------------
# This file OVERRIDES the generated cluster-network-02-config.yml
# (files with "local" in the name take precedence)
#
# CRITICAL: deployKubeProxy must be false for KPR to work
#
# Reference: isovalent-openshift.md Lines 240-258
#------------------------------------------------------------------------------

apiVersion: operator.openshift.io/v1
kind: Network
metadata:
  name: cluster
spec:
  # CRITICAL: Disable kube-proxy for Cilium KPR
  deployKubeProxy: false

  # Use Cilium as the CNI
  networkType: Cilium

  # Must match install-config.yaml and ciliumconfig.yaml
  clusterNetwork:
  - cidr: {{ infrastructure.cluster_network.cidr }}
    hostPrefix: {{ infrastructure.cluster_network.host_prefix }}

  externalIP:
    policy: {}

  serviceNetwork:
{% for network in infrastructure.service_network %}
  - {{ network }}
{% endfor %}
