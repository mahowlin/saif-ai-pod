#------------------------------------------------------------------------------
# OLM Subscription for CLIFE (Cilium Lifecycle Operator)
#------------------------------------------------------------------------------
# This subscription is for Day 2 OLM management.
# Day 1: CLIFE deploys directly from the deployment manifest
# Day 2: Approve InstallPlan to let OLM manage future updates
#
# Reference: isovalent-openshift.md Lines 357-362
#------------------------------------------------------------------------------

apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: clife
  namespace: cilium
spec:
  channel: "1.18"
  installPlanApproval: Manual
  name: clife
  source: certified-operators-local
  sourceNamespace: openshift-marketplace
  # Required for KPR - API endpoint before services are established
  config:
    env:
    - name: KUBERNETES_SERVICE_HOST
      value: api-int.{{ cluster.name }}.{{ infrastructure.base_domain }}
    - name: KUBERNETES_SERVICE_PORT
      value: "6443"
