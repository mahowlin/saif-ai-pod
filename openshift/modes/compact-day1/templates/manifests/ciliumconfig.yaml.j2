#------------------------------------------------------------------------------
# CiliumConfig — Compact 3-Node Management Cluster (Day 1)
#------------------------------------------------------------------------------
# Deployed as a Day 1 manifest during agent-based install.
# Replaces OVN-Kubernetes before the cluster finishes bootstrapping.
#
# Key settings:
#   - Tunnel mode (VXLAN) for KubeVirt/HCP compatibility
#   - KPR with socketLB.hostNamespaceOnly for OpenShift Virtualization
#   - BGP control plane enabled (configured post-install via §8 manifests)
#   - 2 operator replicas for HA on 3-node compact
#   - Multus coexistence (exclusive: false)
#------------------------------------------------------------------------------

apiVersion: cilium.io/v1alpha1
kind: CiliumConfig
metadata:
  labels:
    app.kubernetes.io/name: clife
  name: ciliumconfig
spec:
  cluster:
    name: {{ cluster.name }}

  securityContext:
    privileged: true

  # Day 1 Cilium installs before OVN creates br-ex; use the ABI management bond.
  devices:
    - bond0
  nodePort:
    directRoutingDevice: bond0

  # Tunnel mode for KubeVirt compatibility
  routingMode: tunnel
  tunnelProtocol: vxlan
  tunnelPort: 4789
  autoDirectNodeRoutes: false

  # KPR
  kubeProxyReplacement: true
  k8sServiceHost: api-int.{{ cluster.name }}.{{ infrastructure.base_domain }}
  k8sServicePort: 6443
  sessionAffinity: true

  # Required for OpenShift Virtualization + KPR
  socketLB:
    hostNamespaceOnly: true

  bpf:
    masquerade: true

  # Pod CIDR — OCP default for Day 1 Cilium (no OVN migration)
  ipam:
    mode: "cluster-pool"
    operator:
      clusterPoolIPv4PodCIDRList:
        - "{{ infrastructure.cluster_network.cidr }}"
      clusterPoolIPv4MaskSize: {{ infrastructure.cluster_network.host_prefix }}

  # Multus coexistence
  cni:
    binPath: "/var/lib/cni/bin"
    confPath: "/var/run/multus/cni/net.d"
    exclusive: false

  clusterHealthPort: 9940

  # Hubble observability
  hubble:
    enabled: true
    relay:
      enabled: true
    ui:
      enabled: false
    metrics:
      enabled:
        - dns:labelsContext=source_namespace,destination_namespace
        - drop:labelsContext=source_namespace,destination_namespace
        - tcp:labelsContext=source_namespace,destination_namespace
        - icmp:labelsContext=source_namespace,destination_namespace;sourceContext=workload-name|reserved-identity;destinationContext=workload-name|reserved-identity
        - flow:sourceContext=workload-name|reserved-identity;destinationContext=workload-name|reserved-identity;labelsContext=source_namespace,destination_namespace
        - policy:sourceContext=app|workload-name|pod|reserved-identity;destinationContext=app|workload-name|pod|dns|reserved-identity;labelsContext=source_namespace,destination_namespace

  prometheus:
    enabled: true
    serviceMonitor:
      enabled: true

  operator:
    replicas: 2  # HA on 3-node compact
    prometheus:
      enabled: true
      serviceMonitor:
        enabled: true

  # Enterprise features
  enterprise:
    featureGate:
      approved:
        - EnterpriseBGPControlPlane
        - EgressGatewayHA
        - EgressGatewayIPv4
        - GatewayAPI
    bgpControlPlane:
      enabled: true
      secretsNamespace:
        create: false
        name: cilium
    egressGatewayHA:
      enabled: true

  gatewayAPI:
    enabled: true
