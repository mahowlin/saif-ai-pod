# OpenShift Network Operator contract for Cilium kube-proxy replacement.
# This local manifest overrides the installer-generated network configuration.
apiVersion: operator.openshift.io/v1
kind: Network
metadata:
  name: cluster
spec:
  deployKubeProxy: false
  clusterNetwork:
  - cidr: {{ infrastructure.cluster_network.cidr }}
    hostPrefix: {{ infrastructure.cluster_network.host_prefix }}
  externalIP:
    policy: {}
  networkType: Cilium
  serviceNetwork:
{% for network in infrastructure.service_network %}
  - {{ network }}
{% endfor %}
