#------------------------------------------------------------------------------
# Agent Configuration for SNO (Single Node OpenShift)
#------------------------------------------------------------------------------
# Generated from template by render-cluster-config.py
# Cluster: {{ cluster.name }}
# Serial: {{ cluster.nodes[0].serial }}
# MAC eth0: {{ cluster.nodes[0].mac_eth0 }}
# MAC eth1: {{ cluster.nodes[0].mac_eth1 }}
#------------------------------------------------------------------------------

apiVersion: v1alpha1
kind: AgentConfig
metadata:
  name: {{ cluster.name }}

#------------------------------------------------------------------------------
# Rendezvous IP - This is the IP where the bootstrap process coordinates
# For SNO, this is the IP of the single node
#------------------------------------------------------------------------------
rendezvousIP: {{ cluster.nodes[0].ip }}

#------------------------------------------------------------------------------
# Host Configuration
#------------------------------------------------------------------------------
hosts:
  #----------------------------------------------------------------------------
  # SNO Node - {{ cluster.nodes[0].ucs_profile }}
  #----------------------------------------------------------------------------
  - hostname: {{ cluster.nodes[0].hostname }}
    role: master

    # Root device hint - helps installer find the correct boot disk
    # CRITICAL: Use model matching, NOT deviceName. Device names (sda, sdb, etc.)
    # are NOT stable between boots on UCS MRAID controller.
    # Values: "CISCO_VD" (M.2 RAID) or "Micron_5400_MTFD" (single M.2)
    rootDeviceHints:
      model: "{{ cluster.nodes[0].boot_disk_model }}"

    # Network interfaces - both MACs from Intersight for bond
    interfaces:
      - name: eth0
        macAddress: {{ cluster.nodes[0].mac_eth0 }}
      - name: eth1
        macAddress: {{ cluster.nodes[0].mac_eth1 }}

    # Network configuration using NMState format
    # Bond with active-backup for UCS dual-fabric failover
    networkConfig:
      interfaces:
        # Bond interface - active-backup mode for FI-A/FI-B redundancy
        - name: bond0
          type: bond
          state: up
          ipv4:
            enabled: true
            dhcp: false
            address:
              - ip: {{ cluster.nodes[0].ip }}
                prefix-length: 24
          ipv6:
            enabled: false
          link-aggregation:
            mode: active-backup
            options:
              miimon: '100'
              primary: eth0
            port:
              - eth0
              - eth1
        # eth0 - Fabric A
        - name: eth0
          type: ethernet
          state: up
        # eth1 - Fabric B
        - name: eth1
          type: ethernet
          state: up

      dns-resolver:
        config:
          server:
{% for dns in infrastructure.dns_servers %}
            - {{ dns }}
{% endfor %}

      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: {{ infrastructure.gateway }}
            next-hop-interface: bond0
            table-id: 254

#------------------------------------------------------------------------------
# Notes:
#------------------------------------------------------------------------------
#
# 1. MAC addresses resolved from live Intersight data during OpenShift validation
#    - eth0 (Fabric A): {{ cluster.nodes[0].mac_eth0 }}
#    - eth1 (Fabric B): {{ cluster.nodes[0].mac_eth1 }}
#
# 2. Bond configuration:
#    - Mode: active-backup (failover between fabrics)
#    - Primary: eth0 (Fabric A)
#    - miimon: 100ms link monitoring
#
# 3. DNS requirements for SNO:
#    - api.{{ cluster.name }}.{{ infrastructure.base_domain }} -> {{ cluster.nodes[0].ip }}
#    - api-int.{{ cluster.name }}.{{ infrastructure.base_domain }} -> {{ cluster.nodes[0].ip }}
#    - *.apps.{{ cluster.name }}.{{ infrastructure.base_domain }} -> {{ cluster.nodes[0].ip }}
#
# 4. Root device hint uses model matching ("CISCO VD") instead of deviceName.
#    Device names (sda, sdb) are NOT stable between boots on UCS MRAID.
#    The M.2 boot drive presents as "CISCO VD" (MRAID virtual disk).
#
# 5. Network configured for VLAN {{ infrastructure.vlan }} ({{ infrastructure.network_cidr }})
#
#------------------------------------------------------------------------------
