#------------------------------------------------------------------------------
# CiliumConfig for saif-ai-pod with Kube-Proxy Replacement (KPR)
#------------------------------------------------------------------------------
# This configuration enables:
# - Kube-proxy replacement (KPR) for optimized networking
# - VXLAN tunnel mode (port 4789)
# - Hubble observability with UI and enhanced metrics
# - Enterprise features: Egress Gateway HA
#
# Reference: isovalent-openshift.md Lines 146-186
#
# IMPORTANT: When KPR is enabled:
# - chainingMode: portmap is NOT needed (removed)
# - CNIChainingMode featureGate is NOT needed (removed)
# - k8sServiceHost/k8sServicePort MUST be set
#------------------------------------------------------------------------------

apiVersion: cilium.io/v1alpha1
kind: CiliumConfig
metadata:
  labels:
    app.kubernetes.io/name: clife
  name: ciliumconfig
spec:
  # Cluster identification
  cluster:
    name: {{ cluster.name }}

  # Security context (required for CNI)
  securityContext:
    privileged: true

  # Device configuration - specify the interface with the node IP
  # Required for bare metal deployments where auto-detection fails
  # br-ex is the OVS external bridge created by OpenShift networking
  devices:
    - br-ex

  # NodePort configuration - includes direct routing device
  nodePort:
    # Direct routing device - required even in tunnel mode for VXLAN endpoints
    # Without this, Cilium fails with "unable to determine direct routing device"
    directRoutingDevice: br-ex

  # Routing mode - explicit tunnel configuration
  # This is required with KPR on bare metal
  routingMode: tunnel
  tunnelProtocol: vxlan
  autoDirectNodeRoutes: false

  # FlashStack CVD: Socket LB for OpenShift Virtualization support
  socketLB:
    hostNamespaceOnly: true

  # IPAM configuration - Uses Cilium-specific CIDR (non-overlapping with OVN)
  # See FlashStack CVD page 100: "must not overlap with existing OVN-Kubernetes network"
  ipam:
    mode: "cluster-pool"
    operator:
      clusterPoolIPv4PodCIDRList:
        - "{{ infrastructure.cilium_network.cidr }}"
      clusterPoolIPv4MaskSize: {{ infrastructure.cilium_network.host_prefix }}

  # CNI configuration - NO chainingMode with KPR
  cni:
    binPath: "/var/lib/cni/bin"
    confPath: "/var/run/multus/cni/net.d"
    exclusive: false

  # Avoid conflicts with other services
  clusterHealthPort: 9940

  # Kube-proxy replacement (full mode) - REQUIRED settings
  kubeProxyReplacement: true
  k8sServiceHost: api-int.{{ cluster.name }}.{{ infrastructure.base_domain }}
  k8sServicePort: 6443

  # Session affinity for services
  sessionAffinity: true

  # BPF masquerading
  bpf:
    masquerade: true

  # Hubble observability
  # NOTE: Legacy Hubble UI disabled - using Hubble Timescape instead
  hubble:
    enabled: true
    relay:
      enabled: true
    ui:
      enabled: false
    metrics:
      enabled:
        - dns:labelsContext=source_namespace,destination_namespace
        - drop:labelsContext=source_namespace,destination_namespace
        - tcp:labelsContext=source_namespace,destination_namespace
        - icmp:labelsContext=source_namespace,destination_namespace;sourceContext=workload-name|reserved-identity;destinationContext=workload-name|reserved-identity
        - flow:sourceContext=workload-name|reserved-identity;destinationContext=workload-name|reserved-identity;labelsContext=source_namespace,destination_namespace
        - policy:sourceContext=app|workload-name|pod|reserved-identity;destinationContext=app|workload-name|pod|dns|reserved-identity;labelsContext=source_namespace,destination_namespace

  # Prometheus monitoring
  prometheus:
    enabled: true
    serviceMonitor:
      enabled: true
  # Cilium operator configuration
  operator:
    # Single replica for SNO (avoids hostPort conflict on 2nd replica)
    replicas: 1
    prometheus:
      enabled: true
      serviceMonitor:
        enabled: true

  # L2 Announcements for LoadBalancer IPs (bare metal, no BGP required)
  l2announcements:
    enabled: true

  # Enterprise features - NO CNIChainingMode with KPR
  enterprise:
    featureGate:
      approved:
        - EgressGatewayHA
        - EgressGatewayIPv4
        - L2Announcement    # LoadBalancer IP advertisement via ARP
        - GatewayAPI        # Kubernetes Gateway API support
    # BGP disabled - future roadmap
    bgpControlPlane:
      enabled: false
    # Egress Gateway HA enabled
    egressGatewayHA:
      enabled: true
